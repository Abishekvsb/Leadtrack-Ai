# ==============================================================================
# LeadTrack AI – Environment Variables Reference (.env.example)
# Production-ready Intelligent Lead Management for Educational Institutions
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Neon / Supabase / Render Postgres)
# ------------------------------------------------------------------------------
# DATABASE_URL = Neon pooled string with -pooler in the host; must end with ?sslmode=require and be wrapped in double quotes.
DATABASE_URL="postgresql://neondb_owner:your_password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL = Neon direct string without -pooler; must end with ?sslmode=require and be wrapped in double quotes.
DIRECT_URL="postgresql://neondb_owner:your_password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# JWT_SECRET: Cryptographic secret used for signing and verifying JSON Web Tokens (session cookies).
# Generate using `openssl rand -base64 32` or a 32+ character random string.
JWT_SECRET="generate-a-strong-32-character-secret-key-for-jwt-signing"

# AUTH_SECRET: Optional alias for NextAuth/auth utilities.
AUTH_SECRET="generate-a-strong-32-character-secret-key-for-jwt-signing"

# NEXT_PUBLIC_APP_URL: Canonical base URL of the deployed app (no trailing slash).
# Used for generating counselor invite links, enquiry forms, and password resets.
NEXT_PUBLIC_APP_URL="https://leadtrack-ai.onrender.com"

# ------------------------------------------------------------------------------
# 3. BACKGROUND CRON & AUTOMATIONS
# ------------------------------------------------------------------------------
# CRON_SECRET: Bearer token / query secret used to protect POST /api/cron/run-automations.
# Render Cron or an external monitor (UptimeRobot, cron-job.org) calls:
# POST https://leadtrack-ai.onrender.com/api/cron/run-automations?secret=YOUR_CRON_SECRET
CRON_SECRET="generate-a-strong-random-cron-secret-token"

# ------------------------------------------------------------------------------
# 4. EMAIL SERVICE (SMTP / Nodemailer)
# ------------------------------------------------------------------------------
# Configure SMTP credentials for counselor invitations, password resets, and automated lead emails.
# If omitted or unconfigured, the app logs outgoing emails safely to server console in development.
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT="587"
SMTP_USER="postmaster@yourinstitution.edu"
SMTP_PASS="your-smtp-secret-password"
EMAIL_FROM="LeadTrack Admissions <admissions@yourinstitution.edu>"

# ------------------------------------------------------------------------------
# 5. AI COPILOT ENGINE (Gemini / Anthropic)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Google Gemini API key (Free tier available at https://aistudio.google.com).
# When provided, powers live streaming responses grounded in institution database metrics.
GEMINI_API_KEY=""

# ANTHROPIC_API_KEY: Optional Anthropic Claude API key for high-reasoning copilot queries.
# If neither API key is provided, the copilot seamlessly uses the built-in intelligent
# rule-based intent engine and app knowledge base without throwing errors.
ANTHROPIC_API_KEY=""
