# ==========================================
# LeadTrack AI Environment Configuration
# ==========================================

# Database Connection (SQLite by default for zero-config local run)
# For production (PostgreSQL on Neon/Supabase), change provider to 'postgresql' in schema.prisma and set:
# DATABASE_URL="postgresql://user:password@host:5432/leadtrack?sslmode=require"
DATABASE_URL="file:./dev.db"

# Authentication Secret
JWT_SECRET="leadtrack-super-secret-jwt-key-change-in-production-2026"
NEXTAUTH_SECRET="leadtrack-super-secret-jwt-key-change-in-production-2026"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email Configuration (Optional - logs to console mock if unconfigured)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="LeadTrack AI <admissions@leadtrack.ai>"

# Optional AI Key (OpenAI / Gemini for AI Assistant panel)
# If left empty, high-accuracy intelligent rule-based engine generates suggestions
AI_API_KEY=""

